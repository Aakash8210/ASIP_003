  "behaviour_scenarios": [
    {
      "id": "beh-01-continuous-presence",
      "name": "Normal Continuous Single Face Presence",
      "signal_under_test": "FACE_PRESENCE_CONSISTENCY",
      "frames_count": 10,
      "expected_signals": {
        "FACE_PRESENCE_CONSISTENCY": {
          "status": "observed",
          "classification": "high"
        },
        "MULTIPLE_FACES": {
          "status": "not_observed"
        },
        "FACE_ABSENCE": {
          "status": "not_observed"
        }
      }
    },
    {
      "id": "beh-02-multiple-faces-burst",
      "name": "Repeated Multiple Face Presence (Burst)",
      "signal_under_test": "MULTIPLE_FACES",
      "frames_count": 10,
      "expected_signals": {
        "MULTIPLE_FACES": {
          "status": "observed",
          "min_count": 2
        },
        "FACE_ABSENCE": {
          "status": "not_observed"
        }
      }
    },
    {
      "id": "beh-03-face-absence-run",
      "name": "Candidate Face Absence Run (>2500ms)",
      "signal_under_test": "FACE_ABSENCE",
      "frames_count": 10,
      "expected_signals": {
        "FACE_ABSENCE": {
          "status": "observed",
          "min_consecutive": 3
        },
        "MULTIPLE_FACES": {
          "status": "not_observed"
        }
      }
    },
    {
      "id": "beh-04-blink-suppression",
      "name": "Single Frame Blink False-Positive Suppression",
      "signal_under_test": "FACE_ABSENCE",
      "frames_count": 10,
      "expected_signals": {
        "FACE_ABSENCE": {
          "status": "not_observed"
        },
        "FACE_PRESENCE_CONSISTENCY": {
          "status": "observed",
          "classification": "high"
        }
      }
    },
    {
      "id": "beh-05-transient-glitch-suppression",
      "name": "Single Frame Multi-Face Artifact Suppression",
      "signal_under_test": "MULTIPLE_FACES",
      "frames_count": 10,
      "expected_signals": {
        "MULTIPLE_FACES": {
          "status": "not_observed"
        }
      }
    },
    {
      "id": "beh-06-quality-degradation",
      "name": "Persistent Frame Blur / Low Exposure Quality Degradation",
      "signal_under_test": "FRAME_QUALITY_SUMMARY",
      "frames_count": 10,
      "expected_signals": {
        "FRAME_QUALITY_SUMMARY": {
          "status": "observed"
        }
      }
    },
    {
      "id": "beh-07-sampling-gap",
      "name": "Monitoring Data Quality Sampling Gap (>3000ms)",
      "signal_under_test": "MONITORING_DATA_QUALITY",
      "frames_count": 8,
      "expected_signals": {
        "MONITORING_DATA_QUALITY": {
          "status": "observed"
        }
      }
    },
    {
      "id": "beh-08-low-presence-continuity",
      "name": "Low Presence Continuity (<70% presence ratio)",
      "signal_under_test": "FACE_PRESENCE_CONSISTENCY",
      "frames_count": 10,
      "expected_signals": {
        "FACE_PRESENCE_CONSISTENCY": {
          "status": "observed",
          "classification": "low"
        }
      }
    },
    {
      "id": "beh-09-moderate-presence-continuity",
      "name": "Moderate Presence Continuity (70-89% presence ratio)",
      "signal_under_test": "FACE_PRESENCE_CONSISTENCY",
      "frames_count": 10,
      "expected_signals": {
        "FACE_PRESENCE_CONSISTENCY": {
          "status": "observed",
          "classification": "moderate"
        }
      }
    },
    {
      "id": "beh-10-idempotent-replay",
